    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "datos = pd.DataFrame({\n",
    "    \"año\": [2019, 2020, 2021, 2022, 2023],\n",
    "    \"valor\": [100, 92, 105, 110, 115],\n",
    "})\n",
    "\n",
    "print(datos.describe())\n",
    "datos.plot(x=\"año\", y=\"valor\", marker=\"o\")\n",
    "plt.title(\"Mi primer gráfico\")\n",
    "plt.show()"
   ]
